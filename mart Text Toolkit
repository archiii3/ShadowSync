<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Velto — Smart Text Toolkit</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background: #0b0d10;
      color: #f2f4f7;
      display: flex;
      justify-content: center;
      padding: 40px 20px;
    }

    .app {
      width: 100%;
      max-width: 900px;
    }

    header {
      margin-bottom: 28px;
    }

    h1 {
      margin: 0;
      font-size: 32px;
      letter-spacing: -1px;
    }

    header p {
      margin: 8px 0 0;
      color: #8d96a3;
      font-size: 15px;
    }

    .panel {
      background: #11151a;
      border: 1px solid #20262e;
      border-radius: 16px;
      overflow: hidden;
    }

    textarea {
      width: 100%;
      min-height: 300px;
      padding: 20px;
      border: 0;
      outline: 0;
      resize: vertical;
      background: transparent;
      color: #f2f4f7;
      font: 15px/1.7 Consolas, monospace;
    }

    textarea::placeholder {
      color: #5f6874;
    }

    .toolbar {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      padding: 14px;
      border-top: 1px solid #20262e;
      background: #0e1115;
    }

    button {
      border: 1px solid #29313a;
      background: #171c22;
      color: #dfe4ea;
      padding: 9px 13px;
      border-radius: 8px;
      cursor: pointer;
      font-size: 13px;
      transition: 0.15s ease;
    }

    button:hover {
      background: #202731;
      border-color: #3a4551;
    }

    button.primary {
      background: #f2f4f7;
      color: #0b0d10;
      border-color: #f2f4f7;
      font-weight: 600;
    }

    .stats {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 10px;
      margin-top: 14px;
    }

    .stat {
      background: #11151a;
      border: 1px solid #20262e;
      border-radius: 12px;
      padding: 14px;
    }

    .stat span {
      display: block;
      color: #7f8996;
      font-size: 12px;
      margin-bottom: 5px;
    }

    .stat strong {
      font-size: 18px;
    }

    .status {
      margin-top: 12px;
      min-height: 20px;
      color: #7f8996;
      font-size: 13px;
    }

    @media (max-width: 600px) {
      .stats {
        grid-template-columns: repeat(2, 1fr);
      }

      h1 {
        font-size: 27px;
      }
    }
  </style>
</head>

<body>

  <main class="app">

    <header>
      <h1>Velto</h1>
      <p>A fast, private text toolkit that runs entirely in your browser.</p>
    </header>

    <section class="panel">

      <textarea id="editor"
        placeholder="Paste or write your text here..."></textarea>

      <div class="toolbar">
        <button onclick="transformText('upper')">UPPERCASE</button>
        <button onclick="transformText('lower')">lowercase</button>
        <button onclick="cleanSpaces()">Clean Spaces</button>
        <button onclick="removeDuplicates()">Unique Lines</button>
        <button onclick="sortLines()">Sort Lines</button>
        <button onclick="copyText()" class="primary">Copy</button>
        <button onclick="clearText()">Clear</button>
      </div>

    </section>

    <div class="stats">
      <div class="stat">
        <span>Characters</span>
        <strong id="characters">0</strong>
      </div>

      <div class="stat">
        <span>Words</span>
        <strong id="words">0</strong>
      </div>

      <div class="stat">
        <span>Lines</span>
        <strong id="lines">0</strong>
      </div>

      <div class="stat">
        <span>Reading time</span>
        <strong id="time">0 min</strong>
      </div>
    </div>

    <div class="status" id="status"></div>

  </main>

  <script>
    const editor = document.getElementById("editor");
    const characters = document.getElementById("characters");
    const words = document.getElementById("words");
    const lines = document.getElementById("lines");
    const time = document.getElementById("time");
    const status = document.getElementById("status");

    editor.addEventListener("input", updateStats);

    function updateStats() {
      const text = editor.value;

      characters.textContent = text.length;

      const wordCount = text.trim()
        ? text.trim().split(/\s+/).length
        : 0;

      words.textContent = wordCount;

      const lineCount = text
        ? text.split(/\n/).length
        : 0;

      lines.textContent = lineCount;

      const readingMinutes = wordCount
        ? Math.max(1, Math.ceil(wordCount / 200))
        : 0;

      time.textContent = `${readingMinutes} min`;
    }

    function transformText(type) {
      if (type === "upper") {
        editor.value = editor.value.toUpperCase();
      }

      if (type === "lower") {
        editor.value = editor.value.toLowerCase();
      }

      updateStats();
      showStatus("Text transformed.");
    }

    function cleanSpaces() {
      editor.value = editor.value
        .split("\n")
        .map(line => line.trim().replace(/\s+/g, " "))
        .join("\n")
        .replace(/\n{3,}/g, "\n\n");

      updateStats();
      showStatus("Extra spaces removed.");
    }

    function removeDuplicates() {
      const lines = editor.value
        .split("\n")
        .map(line => line.trim())
        .filter(Boolean);

      editor.value = [...new Set(lines)].join("\n");

      updateStats();
      showStatus("Duplicate lines removed.");
    }

    function sortLines() {
      const lines = editor.value
        .split("\n")
        .filter(line => line.trim());

      editor.value = lines
        .sort((a, b) => a.localeCompare(b))
        .join("\n");

      updateStats();
      showStatus("Lines sorted.");
    }

    async function copyText() {
      if (!editor.value) {
        showStatus("Nothing to copy.");
        return;
      }

      try {
        await navigator.clipboard.writeText(editor.value);
        showStatus("Copied to clipboard.");
      } catch {
        editor.select();
        document.execCommand("copy");
        showStatus("Copied to clipboard.");
      }
    }

    function clearText() {
      editor.value = "";
      updateStats();
      showStatus("Editor cleared.");
    }

    function showStatus(message) {
      status.textContent = message;

      clearTimeout(window.statusTimer);

      window.statusTimer = setTimeout(() => {
        status.textContent = "";
      }, 2000);
    }

    updateStats();
  </script>

</body>
</html>
